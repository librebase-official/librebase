import bundle
import state
import runerr
import seam

def container_version_major() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0

def container_version_minor() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_version_patch() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0

def container_version_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return container_runtime_tag_i()

def container_linux_available() -> int
  requires true
  ensures true
  decreases 0
=
  return container_is_linux_i()

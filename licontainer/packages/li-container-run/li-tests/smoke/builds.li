import container
import container.state
import container.seam

def smoke_state_roundtrip_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if container_version_minor() != 1:
    return 1
  if smoke_state_roundtrip_tag() != 1:
    return 1
  if container_runtime_tag_i() != 1:
    return 1
  return 0

#!/usr/bin/env bash
# Git credential helper: use gh CLI OAuth token from ~/.config/gh/hosts.yml
# instead of the injected GH_TOKEN (often a read-only fine-grained PAT).
set -euo pipefail

host=""
while IFS= read -r line; do
  case "$line" in
    host=*) host="${line#host=}" ;;
  esac
done

if [[ -z "$host" || "$host" != "github.com" ]]; then
  exit 0
fi

hosts="${GH_CONFIG_DIR:-$HOME/.config/gh}/hosts.yml"
if [[ ! -f "$hosts" ]]; then
  exit 0
fi

user="$(awk -F': ' '/^    user: / {print $2; exit}' "$hosts" | tr -d '"')"
token="$(awk -F': ' '/oauth_token: / {print $2; exit}' "$hosts" | tr -d '"')"

if [[ -z "$user" || -z "$token" ]]; then
  exit 0
fi

printf 'username=%s\n' "$user"
printf 'password=%s\n' "$token"

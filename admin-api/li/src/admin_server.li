# Librebase Admin HTTP server — pure Li.
# Default port 54330 (LIBREBASE_ADMIN_PORT). GET /health implemented; other routes 501 until handlers land.
# Drop-in path parity with admin-api/scripts/admin_server.py.

import seam
import routes
import health

def admin_port_from_env() -> int
  requires true
  ensures result > 0
  ensures result < 65536
  decreases 0
=
  var buf: ptr = net_buf_alloc(16)
  var n: int = container_getenv_i("LIBREBASE_ADMIN_PORT", buf, 16)
  var port: int = 54330
  if n > 0:
    port = container_str_atoi_i(buf, 54330)
  if port <= 0:
    port = 54330
  if port >= 65536:
    port = 54330
  return port

def not_impl_body(buf: ptr) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  # {"ok":false,"error":"not_implemented_li"} — compact emit (full JSON restored when handlers land)
  li_rt_vec_i32_set(buf, 0, 123)
  li_rt_vec_i32_set(buf, 1, 34)
  li_rt_vec_i32_set(buf, 2, 111)
  li_rt_vec_i32_set(buf, 3, 107)
  li_rt_vec_i32_set(buf, 4, 34)
  li_rt_vec_i32_set(buf, 5, 58)
  li_rt_vec_i32_set(buf, 6, 102)
  li_rt_vec_i32_set(buf, 7, 97)
  li_rt_vec_i32_set(buf, 8, 108)
  li_rt_vec_i32_set(buf, 9, 115)
  li_rt_vec_i32_set(buf, 10, 101)
  li_rt_vec_i32_set(buf, 11, 125)
  li_rt_vec_i32_set(buf, 12, 0)
  return 0

def main() raises Net, Alloc, IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var port: int = admin_port_from_env()
  var listen_fd: int = tcp_listen(port)
  var okbody: ptr = net_buf_alloc(64)
  var nibody: ptr = net_buf_alloc(64)
  var z0: int = fill_health_body(okbody)
  var z1: int = not_impl_body(nibody)
  # Large cap — harness-long-lived; bounded loop keeps lic build termination-friendly.
  var n: int = 0
  while n < 100000000:
    var conn: int = tcp_accept(listen_fd)
    var req: ptr = tcp_recv_i(conn, 8192)
    var rid: int = route_id(req)
    var status: int = 501
    if rid == 1:
      status = 200
    if rid == 0:
      status = 404
    var body: ptr = nibody
    if rid == 1:
      body = okbody
    tcp_http_write_response(conn, status, body)
    tcp_close(conn)
    n = n + 1
  tcp_close(listen_fd)
  return 0

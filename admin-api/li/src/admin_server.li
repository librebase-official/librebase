# Librebase Admin HTTP server — pure Li.
# Port 54330. GET /health implemented; other routes 501 until handlers land.
# Drop-in path parity with admin-api/scripts/admin_server.py.

import seam
import routes
import health

def not_impl_body(buf: ptr) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  # {"ok":false,"error":"not_implemented_li"}
  li_rt_vec_i32_set(buf, 0, 123)
  li_rt_vec_i32_set(buf, 1, 34)
  li_rt_vec_i32_set(buf, 2, 111)
  li_rt_vec_i32_set(buf, 3, 107)
  li_rt_vec_i32_set(buf, 4, 34)
  li_rt_vec_i32_set(buf, 5, 58)

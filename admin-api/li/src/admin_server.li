  li_rt_vec_i32_set(buf, 41, 0)
  return 0

def main() raises Net, Alloc, IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var listen_fd: int = tcp_listen(54330)
  var okbody: ptr = net_buf_alloc(64)
  var nibody: ptr = net_buf_alloc(64)
  var z0: int = fill_health_body(okbody)
  var z1: int = not_impl_body(nibody)
  var n: int = 0
  while n < 64:
    var conn: int = tcp_accept(listen_fd)
    var req: ptr = tcp_recv_i(conn, 8192)
    var rid: int = route_id(req)
    if rid == 1:
      tcp_http_write_response(conn, 200, okbody)
    if rid != 1:
      if rid == 0:
        tcp_http_write_response(conn, 404, nibody)
      if rid != 0:
        tcp_http_write_response(conn, 501, nibody)
    tcp_close(conn)
    n = n + 1
  tcp_close(listen_fd)
  return 0

  li_rt_vec_i32_set(buf, 10, 101)
  li_rt_vec_i32_set(buf, 11, 44)
  li_rt_vec_i32_set(buf, 12, 34)
  li_rt_vec_i32_set(buf, 13, 101)
  li_rt_vec_i32_set(buf, 14, 114)
  li_rt_vec_i32_set(buf, 15, 114)
  li_rt_vec_i32_set(buf, 16, 111)
  li_rt_vec_i32_set(buf, 17, 114)
  li_rt_vec_i32_set(buf, 18, 34)
  li_rt_vec_i32_set(buf, 19, 58)
  li_rt_vec_i32_set(buf, 20, 34)
  li_rt_vec_i32_set(buf, 21, 110)
  li_rt_vec_i32_set(buf, 22, 111)

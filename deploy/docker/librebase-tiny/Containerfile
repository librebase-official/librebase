# librebase-tiny — the smallest Librebase runtime: static Go HTTP shim + static
# lidb engine in a scratch image. Target: ≤64MB RSS, <300ms startup, sub-ms CRUD
# (lidb-engine `session` NDJSON over a persistent child).

# ---- stage 1: build static lidb-engine (Linux) ----
FROM docker.io/library/gcc:13-bookworm AS lidb
RUN apt-get update && apt-get install -y --no-install-recommends cmake ninja-build && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY lidb/ ./
# Static: -static with glibc (libstdc++ static). Uses C++20 std::filesystem.
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CXX_FLAGS="-static -O2" \
      -DCMAKE_EXE_LINKER_FLAGS="-static -lstdc++fs" >/dev/null && \
    cmake --build build --target lidb-engine -j$(nproc) >/dev/null

# ---- stage 2: build static Go shim ----
FROM docker.io/library/golang:1.23-alpine AS go
WORKDIR /shim
COPY librebase/deploy/docker/librebase-tiny/server.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o tiny-lb server.go

# ---- stage 3: scratch (tiniest possible) ----
FROM scratch
COPY --from=lidb /src/build/lidb-engine /usr/local/bin/lidb-engine
COPY --from=go /shim/tiny-lb /usr/local/bin/tiny-lb
COPY librebase/deploy/docker/librebase-tiny/migrations/ /etc/librebase/migrations/
ENV LI_DATA_DIR=/data PORT=8788 LIDB_MIGRATIONS=/etc/librebase/migrations
EXPOSE 8788
ENTRYPOINT ["/usr/local/bin/tiny-lb"]

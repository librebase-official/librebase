# Librebase staging environment — run on homelab (engine)
# Copy this to .env.staging and fill in real values.
# .env.staging is gitignored.

# --- JWT / auth ---
LIBREBASE_ADMIN_JWT_SECRET=CHANGE_ME

# --- KMS ---
LIBREBASE_KMS_SERVICE_ROLE=CHANGE_ME

# --- Console URL (Studio UI public endpoint) ---
LIBREBASE_CONSOLE_URL=https://stage.librebase.xyz

# --- Hetzner (empty = provisioning disabled in staging) ---
LIBREBASE_HETZNER_API_TOKEN=
LIBREBASE_HETZNER_SSH_KEY_ID=
LIBREBASE_HETZNER_IMAGE_ID=
LIBREBASE_HETZNER_SERVER_TYPE=cx23

# --- Grok / xAI ---
LIBREBASE_GROK_CLIENT_ID=

# --- Supabase (shared with production for waitlist) ---
LIBREBASE_SUPABASE_URL=
LIBREBASE_SUPABASE_SERVICE_ROLE_KEY=

# --- Admin dashboard token (saas-admin-api) ---
ADMIN_DASHBOARD_TOKEN=CHANGE_ME

# --- Shiphook deploy (staging) ---
SHIPHOOK_DEPLOY_TOKEN=CHANGE_ME

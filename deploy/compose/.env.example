# Librebase self-host — copy to deploy/compose/.env and replace every CHANGE_ME.
# Never commit deploy/compose/.env (real secrets).

# --- Version (keep in sync with repo VERSION / compose.env) ---
LIBREBASE_VERSION=0.1.38

# --- Public URLs (must match what users type in the browser) ---
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3005
LIBREBASE_CONSOLE_URL=http://127.0.0.1:3005

# --- Admin API (required) ---
LIBREBASE_ADMIN_JWT_SECRET=CHANGE_ME

# --- KMS (required) ---
LIBREBASE_KMS_SERVICE_ROLE=CHANGE_ME

# --- OAuth sign-in (optional; leave empty to use email/password setup only) ---
LIBREBASE_GOOGLE_CLIENT_ID=
LIBREBASE_GOOGLE_CLIENT_SECRET=
LIBREBASE_GITHUB_CLIENT_ID=
LIBREBASE_GITHUB_CLIENT_SECRET=

# --- Studio runtime (optional) ---
# LIBREBASE_HARNESS=oss
# LIBREBASE_RUNTIME=local
=======
# Copy to .env in this directory before `docker compose up`.
# Use long random values — never commit the real .env file.

LIBREBASE_ADMIN_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
LIBREBASE_KMS_SERVICE_ROLE=REPLACE_WITH_LONG_RANDOM_STRING

# Public URL users open in the browser (used at Studio build/runtime).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3005

# Do not set LIBREBASE_ADMIN_BIND=127.0.0.1 here — compose forces 0.0.0.0 so Studio can reach admin.

# Hetzner Cloud API credentials for VM provisioning.
# 1. Copy this file to .env.hetzner (which is gitignored)
# 2. Fill in your API token from https://console.hetzner.cloud/projects → API Tokens
# 3. The admin-api will read these env vars at startup
LIBREBASE_HETZNER_API_TOKEN=
LIBREBASE_HETZNER_SSH_KEY_ID=
LIBREBASE_HETZNER_IMAGE_ID=
LIBREBASE_HETZNER_SERVER_TYPE=cx23
LIBREBASE_HETZNER_REGION=nbg1
